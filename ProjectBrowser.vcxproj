  <ItemGroup><ClCompile Include="ProjectBrowser.cpp" /><ClCompile Include="CodeEditor.cpp" /><ClCompile Include="ProjectFs.cpp" /><ClCompile Include="Highlighter.cpp" /></ItemGroup>
  <ItemGroup><ClInclude Include="CodeEditor.h" /><ClInclude Include="ProjectFs.h" /><ClInclude Include="Highlighter.h" /><ClInclude Include="QtLite.h" /><ClInclude Include="Version.h" /><ClInclude Include="$(ModToolsSdkDir)\modtools_plugin.h" /><ClInclude Include="$(ModToolsSdkDir)\modtools_plugin.hpp" /></ItemGroup>
